<Project>
  <!-- Shared settings for every project in the solution (single source of version truth). -->
  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>efamin322</Authors>
    <Company>efamin322</Company>
    <Copyright>Copyright (c) 2026 efamin322</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
